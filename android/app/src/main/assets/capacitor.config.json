{
	"appId": "com.ghinan.eksis",
	"appName": "EKSIS",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false,
		"allowNavigation": [
			"https://eksis-ghinan.ai.studio/*",
			"*.ai.studio",
			"api.whatsapp.com",
			"wa.me"
		]
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#0f172a"
	},
	"plugins": {
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0f172a"
		}
	}
}
